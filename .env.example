# SmartStock Supermarket - Environment Configuration

# Flask Application Secret Key
SECRET_KEY=smartstock-supermarket-secret-key-2026-prod-jwt

# Debug mode (True for development, False for production)
FLASK_DEBUG=True
PORT=5000

# Database Configuration:
# Option 1: MySQL (Recommended for production)
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/smartstock
# Or using discrete variables:
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_password
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=smartstock

# Option 2: SQLite (Auto-fallback if MySQL credentials are empty)
# SQLite will automatically be created in smartstock.db
